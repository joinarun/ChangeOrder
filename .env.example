# Use Node 22.13+ (Node 24 recommended). Copy to .env and keep credentials local.
PORT=3001
APP_BASE_URL=http://localhost:5173
DATABASE_PATH=data/changeorder.sqlite
OWNER_ACCESS_CODE=change-this-before-hosting
SESSION_SECRET=replace-with-at-least-32-random-characters

# OpenAI-compatible LLM proxy. Never prefix browser env vars with these secrets.
LLM_PROXY_BASE_URL=https://your-openai-compatible-endpoint/openai/v1
LLM_PROXY_ACCESS_TOKEN=
LLM_MODEL=gpt-4.1
LLM_APP_NAME=changeorder

# Sandbox credentials only. Never commit your client secret.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
